{
  "name": "boxscore",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bun": ">=1.1"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "bun --watch src/server/index.ts",
    "build": "bun run typecheck && vite build",
    "serve": "bun src/server/index.ts",
    "report": "bun src/server/cli.ts",
    "validate": "bun src/server/cli.ts --format validate",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint --no-error-on-unmatched-pattern src",
    "test": "bun --bun vitest run"
  },
  "dependencies": {
    "@mattstack/app-kit": "workspace:*",
    "@mattstack/app-server": "workspace:*",
    "@mattstack/glance": "catalog:",
    "@mattstack/mantine-tokyo": "workspace:*",
    "@mattstack/rt-client": "catalog:",
    "@mattstack/settings-kit": "^0.1.3",
    "@tanstack/react-query": "catalog:",
    "hono": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "wouter": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "typescript": "catalog:",
    "typescript-eslint": "^8.64.0",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
