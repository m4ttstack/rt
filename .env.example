# Copy to .env and fill in. NEVER commit .env.
# The token stays server-side only (see spec section 2); it is never sent to the browser.

# GitLab instance: https://gitlab.com or your self-managed host (no trailing slash).
GITLAB_BASE_URL=https://gitlab.com

# Personal Access Token with the read_api scope ONLY. Do NOT use the full `api` scope.
# Create at: <GITLAB_BASE_URL>/-/user_settings/personal_access_tokens
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Optional: Linear personal API key, enables the "Issues done" delivery metric.
# Leave unset to disable Linear ... the GitLab leaderboard works without it.
# Create at: https://linear.app/settings/account/security (or /settings/api).
# LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxxxxxx

# Optional: port the backend listens on (default 8787).
# PORT=8787
