      "type": "frame",
      "id": "K7voBF",
      "x": 0,
      "y": 1360,
      "name": "B · The header line earns its keep",
      "theme": {
        "mode": "dark"
      },
      "width": 1440,
      "fill": "$bg",
      "layout": "vertical",
      "gap": 20,
      "padding": 40,
      "children": [
        {
          "type": "text",
          "id": "HobaE",
          "name": "B · The header line earns its keep",
          "fill": "$fg",
          "content": "B · The header line earns its keep",
          "fontFamily": "$font-sans",
          "fontSize": 20,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "s7w34",
          "name": "Keeps today's four lines and the anchored corner, but the header line always has a job: the author moves up from the facts line (muted, not purple), and the flags sit beside them as colored words. The facts line drops to five tokens. Hover: same contract as A; the checkbox sits level with the title.",
          "fill": "$muted",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Keeps today's four lines and the anchored corner, but the header line always has a job: the author moves up from the facts line (muted, not purple), with the branch-health facts beside them: flags as colored words, and the behind count as a muted \"N behind\". The facts line is then identity only (!iid, branch, diff) plus the threads token and the age, so the green/red diff is the only colored number on it. Hover: same contract as A; the checkbox sits level with the title.",
          "fontFamily": "$font-sans",
          "fontSize": 13
        },
