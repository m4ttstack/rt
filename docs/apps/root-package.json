{
  "name": "app-kit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "packages/tui-kit/workshop"
  ],
  "scripts": {
    "typecheck": "bun run --filter '@mattstack/*' typecheck && bun run probe:typecheck",
    "lint": "eslint --no-error-on-unmatched-pattern packages .storybook && bun run probe:lint",
    "test": "vitest",
    "format": "prettier --write . --cache",
    "format:check": "prettier --check . --cache",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "treeshake": "packages/ui/scripts/treeshake-check.sh",
    "tui-kit:build": "cd packages/tui-kit && bun run build",
    "tui-kit:test": "cd packages/tui-kit && bun run test",
    "tui-kit:gates": "cd packages/tui-kit && bun run gates",
    "tokens:test": "cd packages/tokens && bun run test",
    "tokens:codegen": "bun run packages/tokens/scripts/generate.ts",
    "probe:install": "rm -rf probe/node_modules/@mattstack probe/node_modules/.bun probe/vendor probe/bun.lock && mkdir -p probe/vendor && (cd packages/tokyo && bun pm pack --destination ../../probe/vendor --quiet) && (cd packages/ui && bun pm pack --destination ../../probe/vendor --quiet) && (cd packages/server && bun pm pack --destination ../../probe/vendor --quiet) && bun scripts/sync-probe-refs.ts && cd probe && bun install",
    "probe:typecheck": "cd probe && bun run typecheck",
    "probe:lint": "if [ -d probe ]; then cd probe && bun run lint; fi",
    "probe:test": "cd probe && bun run test -- --run",
    "probe:build": "cd probe && bun run build",
    "probe:serve-check": "probe/scripts/serve-check.sh"
  },
  "devDependencies": {
    "@mattstack/app-kit": "workspace:*",
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@storybook/addon-a11y": "^10.5.2",
    "@storybook/addon-docs": "^10.5.2",
    "@storybook/react-vite": "^10.5.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.5.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "storybook": "^10.5.2",
    "typescript": "~6",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "@mantine/code-highlight": "^9.5.2",
    "@mantine/core": "^9.5.2",
    "@mantine/dates": "^9.5.2",
    "@mantine/form": "^9.5.2",
    "@mantine/hooks": "^9.5.2",
    "@mantine/modals": "^9.5.2",
    "@mantine/notifications": "^9.5.2",
    "@mantine/spotlight": "^9.5.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "wouter": "^3.10.0",
    "zod": "^4.4.3",
    "hono": "^4.13.5",
    "@mattstack/rt-client": "^0.14.0",
    "@mattstack/glance": "^0.24.0"
  }
}
