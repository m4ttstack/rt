{
  "name": "deck",
  "version": "1.0.0",
  "module": "src/main.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "scripts": {
    "build:board": "bun run scripts/build-board.ts && bun run scripts/build-gateway-css.ts",
    "build": "bun build --compile src/main.ts --outfile dist/deck",
    "serve": "bun run src/main.ts serve",
    "test": "bun test core src",
    "test:dom": "bun test test/dom/",
    "test:e2e": "LOCAL_E2E=1 bun test test/e2e.smoke.test.ts",
    "capture": "bun test/capture.ts --out test/.captures",
    "capture:baseline": "bun test/capture.ts --out test/baselines",
    "capture:compare": "bun test/compare.ts",
    "deploy": "bun run scripts/deploy.ts"
  },
  "dependencies": {
    "@mattstack/rt-client": "^0.10.1",
    "@mattstack/tui-kit": "^0.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
