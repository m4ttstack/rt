{
  "name": "mattstack-console",
  "private": true,
  "version": "0.1.0",
  "description": "mattstack-console, scaffolded with create-mantine-kit.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "serve": "bun run src/server/index.ts",
    "dev:server": "bun run --hot src/server/index.ts",
    "typecheck": "tsc -b",
    "lint": "eslint --no-error-on-unmatched-pattern src .storybook",
    "test": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "prettier --write . --cache",
    "format:check": "prettier --check . --cache",
    "debrand": "scripts/debrand-check.sh",
    "treeshake": "scripts/treeshake-check.sh"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@mantine/code-highlight": "^9.4.1",
    "@mantine/core": "^9.4.1",
    "@mantine/dates": "^9.4.1",
    "@mantine/form": "^9.4.1",
    "@mantine/hooks": "^9.4.1",
    "@mantine/modals": "^9.4.1",
    "@mantine/notifications": "^9.4.1",
    "@mantine/spotlight": "^9.4.1",
    "@mattstack/rt-client": "file:../repo-tools/packages/rt-client",
    "@tanstack/react-query": "^5.102.0",
    "@tanstack/react-virtual": "^3.14.6",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "dayjs": "^1.11.21",
    "hono": "^4.13.3",
    "lucide-react": "^1.25.0",
    "mantine-form-zod-resolver": "1.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-interval-hook": "^1.1.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@storybook/addon-a11y": "^10.5.2",
    "@storybook/addon-docs": "^10.5.2",
    "@storybook/react-vite": "^10.5.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.5.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "storybook": "^10.5.2",
    "typescript": "~6",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
