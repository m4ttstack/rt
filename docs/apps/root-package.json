{
  "name": "boxscore",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bun": ">=1.1"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "bun --watch src/server/index.ts",
    "build": "bun run typecheck && vite build",
    "serve": "bun src/server/index.ts",
    "report": "bun src/server/cli.ts",
    "validate": "bun src/server/cli.ts --format validate",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint --no-error-on-unmatched-pattern src",
    "test": "bun --bun vitest run"
  },
  "dependencies": {
    "@mattstack/app-kit": "^0.1.9",
    "@mattstack/app-server": "^0.1.2",
    "@mattstack/glance": "^0.24.0",
    "@mattstack/rt-client": "^0.12.0",
    "@mattstack/settings-kit": "^0.1.3",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.6.14",
    "lucide-react": "^1.21.0",
    "tailwind-merge": "^3.6.0",
    "wouter": "^3.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.0.0",
    "typescript": "~6",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
