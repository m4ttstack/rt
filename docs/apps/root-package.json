{
  "name": "local",
  "version": "1.0.0",
  "module": "src/main.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "lucide": "1.27.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "scripts": {
    "build:icons": "bun build core/icons.js --outfile core/vendor/lucide.min.js --minify --target=browser --format=iife",
    "build": "bun build --compile src/main.ts --outfile dist/lcl",
    "serve": "bun run src/main.ts serve",
    "test": "bun test core src",
    "test:e2e": "LOCAL_E2E=1 bun test test/e2e.smoke.test.ts"
  }
}
