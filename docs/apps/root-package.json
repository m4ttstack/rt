{
  "name": "chat",
  "private": true,
  "version": "0.1.0",
  "description": "chat, scaffolded with create-mantine-kit.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "serve": "bun run src/server/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --no-error-on-unmatched-pattern src",
    "test": "vitest",
    "format": "prettier --write . --cache",
    "format:check": "prettier --check . --cache"
  },
  "dependencies": {
    "@mantine/code-highlight": "^9.5.2",
    "@mantine/core": "^9.5.2",
    "@mantine/dates": "^9.5.2",
    "@mantine/form": "^9.5.2",
    "@mantine/hooks": "^9.5.2",
    "@mantine/modals": "^9.5.2",
    "@mantine/notifications": "^9.5.2",
    "@mantine/spotlight": "^9.5.2",
    "@mattstack/app-kit": "^0.1.9",
    "@mattstack/app-server": "^0.1.1",
    "@mattstack/mantine-tokyo": "^0.2.0",
    "@mattstack/rt-client": "^0.11.0",
    "@tanstack/react-query": "^5.102.4",
    "hono": "^4.13.5",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-interval-hook": "^1.1.5",
    "react-markdown": "^10.1.0",
    "react-scroll-to-bottom": "^4.2.0",
    "remark-gfm": "^4.0.1",
    "unist-util-visit": "^5.1.0",
    "wouter": "^3.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.14",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-scroll-to-bottom": "^4.2.5",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "typescript": "~6",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
