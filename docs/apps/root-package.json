{
  "name": "app-kit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "workspaces": {
    "packages": [
      "packages/*",
      "packages/tui-kit/workshop",
      "apps/*"
    ],
    "catalog": {
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "@mantine/code-highlight": "^9.5.2",
      "@mantine/core": "^9.5.2",
      "@mantine/dates": "^9.5.2",
      "@mantine/form": "^9.5.2",
      "@mantine/hooks": "^9.5.2",
      "@mantine/modals": "^9.5.2",
      "@mantine/notifications": "^9.5.2",
      "@mantine/spotlight": "^9.5.2",
      "@mattstack/glance": "^0.24.0",
      "@mattstack/rt-client": "0.16.0",
      "@tanstack/react-query": "^5.102.0",
      "@testing-library/react": "^16.3.2",
      "@types/node": "^24.13.2",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "@vitejs/plugin-react": "^6.0.3",
      "hono": "^4.13.3",
      "typescript": "~6",
      "vite": "^8.1.1",
      "vitest": "^4.1.10",
      "wouter": "^3.10.0",
      "zod": "^4.4.3"
    }
  },
  "scripts": {
    "typecheck": "bun run --filter '@mattstack/*' typecheck",
    "lint": "eslint --no-error-on-unmatched-pattern packages .storybook",
    "test": "vitest",
    "format": "prettier --write . --cache",
    "format:check": "prettier --check . --cache",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "treeshake": "packages/ui/scripts/treeshake-check.sh",
    "tui-kit:build": "cd packages/tui-kit && bun run build",
    "tui-kit:test": "cd packages/tui-kit && bun run test",
    "tui-kit:gates": "cd packages/tui-kit && bun run gates",
    "tokens:test": "cd packages/tokens && bun run test",
    "tokens:codegen": "bun run packages/tokens/scripts/generate.ts",
    "chat:typecheck": "cd apps/chat && bun run typecheck",
    "chat:lint": "cd apps/chat && bun run lint",
    "chat:test": "cd apps/chat && bun run test -- --run",
    "chat:build": "cd apps/chat && bun run build",
    "console:typecheck": "cd apps/console && bun run typecheck",
    "console:lint": "cd apps/console && bun run lint",
    "console:test": "cd apps/console && bun run test -- --run",
    "console:build": "cd apps/console && bun run build",
    "boxscore:typecheck": "cd apps/boxscore && bun run typecheck",
    "boxscore:lint": "cd apps/boxscore && bun run lint",
    "boxscore:test": "cd apps/boxscore && bun run test",
    "board:typecheck": "cd apps/board && bun run typecheck",
    "board:test": "cd apps/board && bun run test",
    "board:build": "cd apps/board && bun run build",
    "deck:test": "cd apps/deck && bun run test",
    "deck:test-dom": "cd apps/deck && bun run test:dom"
  },
  "devDependencies": {
    "@mattstack/app-kit": "workspace:*",
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@storybook/addon-a11y": "^10.5.2",
    "@storybook/addon-docs": "^10.5.2",
    "@storybook/react-vite": "^10.5.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.14",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.5.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "storybook": "^10.5.2",
    "typescript": "catalog:",
    "typescript-eslint": "^8.64.0",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@mantine/code-highlight": "catalog:",
    "@mantine/core": "catalog:",
    "@mantine/dates": "catalog:",
    "@mantine/form": "catalog:",
    "@mantine/hooks": "catalog:",
    "@mantine/modals": "catalog:",
    "@mantine/notifications": "catalog:",
    "@mantine/spotlight": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "wouter": "catalog:",
    "zod": "catalog:",
    "hono": "catalog:",
    "@mattstack/rt-client": "catalog:",
    "@mattstack/glance": "catalog:"
  }
}
