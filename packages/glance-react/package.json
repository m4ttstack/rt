{
  "name": "@workforge/glance-react",
  "private": false,
  "version": "0.3.0",
  "description": "Forge Glance React component library — MR dashboards with GDS theming",
  "license": "MIT",
  "type": "module",
  "main": "./dist/main.cjs",
  "module": "./dist/main.mjs",
  "types": "dist/main.d.ts",
  "exports": {
    ".": {
      "bun": "./lib/main.ts",
      "import": {
        "types": "./dist/main.d.ts",
        "default": "./dist/main.mjs"
      },
      "require": {
        "types": "./dist/main.d.ts",
        "default": "./dist/main.cjs"
      }
    },
    "./styles.css": {
      "bun": "./lib/css/styles.css",
      "default": "./dist/styles.css"
    },
    "./tokens.css": {
      "bun": "./lib/css/tokens.css",
      "default": "./dist/tokens.css"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "lib",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/m4ttheweric/Glance.git",
    "directory": "packages/ui-react"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b ./tsconfig.lib.json && vite build && npx @tailwindcss/cli -i lib/css/styles.css -o dist/styles.css --minify && cat lib/css/palette.css lib/css/tokens.css > dist/tokens.css",
    "build:app": "tsc -b ./tsconfig.app.json && vite build --config vite.app.config.ts",
    "dev:app": "vite --config vite.app.config.ts",
    "dev:app:dist": "TEST_DIST=1 vite --config vite.app.config.ts",
    "test": "vitest run",
    "lint": "eslint . --quiet",
    "format:write": "prettier --write \"**/*.{ts,tsx}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx}\" --cache",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "check": "tsc --noEmit",
    "prepublishOnly": "bun run check && bun run build",
    "storybook": "node_modules/.bin/storybook dev -p 6006",
    "build-storybook": "node_modules/.bin/storybook build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@forge-glance/sdk": "^0.5.0",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.2.0",
    "@tailwindcss/vite": "^4.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.4.3",
    "react-icons": "^5.6.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.1",
    "@eslint/js": "^9.19.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.1",
    "@storybook/addon-a11y": "^10.2.17",
    "@storybook/addon-docs": "^10.2.17",
    "@storybook/addon-vitest": "^10.2.17",
    "@storybook/react-vite": "^10.2.17",
    "@types/node": "^25.4.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser": "^3.0.5",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "eslint-plugin-storybook": "^10.2.17",
    "globals": "^15.14.0",
    "happy-dom": "^16.8.1",
    "playwright": "^1.58.2",
    "prettier": "3.4.2",
    "storybook": "^10.2.17",
    "storybook-dark-mode": "^5.0.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.23.0",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.0.5"
  }
}
