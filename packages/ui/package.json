{
  "name": "@mattstack/app-kit",
  "version": "0.4.0",
  "description": "mantine-kit plus the mattstack layer: Tokyo theme, app shell, boot, router helpers, config presets.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m4ttstack/app-kit.git",
    "directory": "packages/ui"
  },
  "files": [
    "src",
    "presets",
    "tsconfig.base.json",
    "!src/**/*.test.*",
    "!src/**/*.stories.*"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./app": "./src/app/index.ts",
    "./boot": "./src/boot/index.ts",
    "./boot/simple-loading-bar.css": "./src/boot/simple-loading-bar.css",
    "./core": "./src/core/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./forms": "./src/forms/index.ts",
    "./modals": "./src/modals/index.ts",
    "./notifications": "./src/notifications/index.ts",
    "./icons": "./src/icons/index.ts",
    "./lazy": "./src/lazy/index.ts",
    "./spotlight": "./src/spotlight/index.ts",
    "./router": "./src/router/index.ts",
    "./design-system": "./src/design-system/index.ts",
    "./utils": "./src/utils/index.ts",
    "./test-utils": "./src/test-utils/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./eslint": "./presets/eslint.js",
    "./vite": {
      "types": "./presets/vite.d.ts",
      "default": "./presets/vite.js"
    },
    "./tsconfig.base.json": "./tsconfig.base.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest"
  },
  "peerDependencies": {
    "@mantine/code-highlight": "catalog:",
    "@mantine/core": "catalog:",
    "@mantine/dates": "catalog:",
    "@mantine/form": "catalog:",
    "@mantine/hooks": "catalog:",
    "@mantine/modals": "catalog:",
    "@mantine/notifications": "catalog:",
    "@mantine/spotlight": "catalog:",
    "@mattstack/mantine-tokyo": "^0.4.0",
    "@testing-library/react": "^16.3.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vitest": "catalog:",
    "wouter": "catalog:",
    "zod": "catalog:"
  },
  "peerDependenciesMeta": {
    "@testing-library/react": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@tanstack/react-virtual": "^3.14.6",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "dayjs": "^1.11.21",
    "lucide-react": "^1.25.0",
    "mantine-form-zod-resolver": "1.3.0",
    "react-interval-hook": "^1.1.5"
  }
}
