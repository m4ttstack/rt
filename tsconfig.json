{
  "extends": "@mattstack/app-kit/tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo"
  },
  "include": ["src", "vite.config.ts", "vitest.setup.ts"],
  // Generated by build:binary, never hand-written; exclude from type-checking.
  // manifest.ts is the current path; generated/ is the pre-app-kit path a
  // stale checkout with old builds may still carry.
  "exclude": [
    "src/server/embedded/manifest.ts",
    "src/server/embedded/generated"
  ]
}
