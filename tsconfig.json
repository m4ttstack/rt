{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  // The apps and their platform packages type-check under turbo with their
  // own tsconfigs; the root project checks the rt CLI, daemon and rt's own
  // three packages (rt-client, settings-kit, git-core) only.
  "exclude": [
    "apps",
    "extensions",
    "website",
    "docs",
    "stories",
    ".storybook",
    "probe",
    "packages/gate-kit",
    "packages/glance",
    "packages/glance-react",
    "packages/server",
    "packages/tokens",
    "packages/tokyo",
    "packages/tui-kit",
    "packages/typescript-config",
    "packages/ui",
    "storybook-static",
    "rt-tray/deps",
    "rt-tray/*.app",
    "eslint.config.mjs"
  ]
}
